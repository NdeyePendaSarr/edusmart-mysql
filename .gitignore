# =====================================================
# .gitignore - EduSmart MySQL
# =====================================================

# --- Secrets ---
.env

# --- Environnement Python ---
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/

# --- Logs ---
logs/
*.log

# --- Données volumineuses ou générées ---
data/*.csv
!data/.gitkeep

# --- Éditeurs / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store

# --- MySQL dumps (peuvent être très gros) ---
*.sql.gz
dumps/